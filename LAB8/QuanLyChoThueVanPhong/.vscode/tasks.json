{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/QuanLyChoThueVanPhong/QuanLyChoThueVanPhong.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "run",
      "command": "dotnet",
      "type": "process",
      "args": [ "run", "--project", "${workspaceFolder}/QuanLyChoThueVanPhong/QuanLyChoThueVanPhong.csproj" ],
      "problemMatcher": "$msCompile"
    }
  ]
}
